[Unit]
Description=NeuroPipe TTS Service (Local AI)
# Wait for sound system to be ready
After=sound.target pipewire.service pulseaudio.service

[Service]
Type=simple
# %h expands to your home directory /home/username
WorkingDirectory=%h/.local/bin
ExecStart=%h/.local/bin/neuro-tts-service

# Restart automatically if it crashes
Restart=always
RestartSec=3

# Optimization: High priority for audio processing
Nice=-10

[Install]
WantedBy=default.target
