#!/usr/bin/env python3
import ast
import os
import subprocess as sp
import sys
from glob import glob

TRIGGER = os.path.expanduser("~/.local/bin/neuro-tts-trigger")
VOICES_DIR = os.path.expanduser("~/.local/share/neuropipe/models/pocket-tts/voices")


def trigger(args):
    out = sp.run([TRIGGER] + args, capture_output=True, text=True).stdout.strip()
    for line in out.splitlines():
        if line.startswith("Reply:"):
            return ast.literal_eval(line[6:])
    return {}


def get_voices():
    return sorted(p for p in glob(os.path.join(VOICES_DIR, "*.safetensors")))


def get_current_voice():
    return trigger(["get_state"]).get("voice", "")


def set_voice(voice):
    trigger(["set_state", "--engine", "pocket-tts", "--voice", voice])
    label = os.path.splitext(os.path.basename(voice))[0]
    sp.run(["notify-send", "-h", "boolean:transient:true", "NeuroPipe TTS", f"pocket-tts | {label}"], capture_output=True)


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("next", "previous"):
        print("Usage: neuro-tts-voice-cycle {next|previous}")
        sys.exit(1)

    direction = sys.argv[1]
    voices = get_voices()
    if not voices:
        print("No voices found.")
        sys.exit(1)

    current = get_current_voice()
    try:
        idx = voices.index(current)
    except ValueError:
        idx = -1

    if idx == -1:
        set_voice(voices[0])
        return

    if direction == "next":
        idx = (idx + 1) % len(voices)
    else:
        idx = (idx - 1) % len(voices)

    set_voice(voices[idx])


if __name__ == "__main__":
    main()
