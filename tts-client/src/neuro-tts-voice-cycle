#!/usr/bin/env python3
import os
import subprocess as sp
import sys
from glob import glob

import zmq

CMD_ADDR = "ipc:///tmp/neuropipe_tts_cmd.sock"
HF_SNAPSHOTS = os.path.expanduser(
    "~/.cache/huggingface/hub/models--kyutai--pocket-tts/snapshots/*/languages/english_2026-04/embeddings"
)
CUSTOM_DIR = os.path.expanduser("~/.local/share/neuropipe/models/pocket-tts/voices")


def notify(title, message):
    sp.run(["notify-send", title, message], capture_output=True)


def send_command(cmd):
    ctx = zmq.Context()
    sock = ctx.socket(zmq.REQ)
    sock.connect(CMD_ADDR)
    sock.send_json(cmd)
    reply = sock.recv_json()
    sock.close()
    return reply


def get_voices():
    snapshots = sorted(glob(HF_SNAPSHOTS))
    predefined = []
    if snapshots:
        predefined = sorted(
            os.path.splitext(p)[0]
            for p in glob(os.path.join(snapshots[0], "*.safetensors"))
        )
    custom = sorted(p for p in glob(os.path.join(CUSTOM_DIR, "*.safetensors")))
    return predefined + custom


def get_current_voice():
    return send_command({"command": "get_state"}).get("voice", "")


def set_voice(voice):
    send_command({"command": "set_state", "engine": "pocket-tts", "voice": voice})
    label = os.path.splitext(os.path.basename(voice))[0]
    notify("NeuroPipe TTS", f"pocket-tts | {label}")


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("next", "previous"):
        print("Usage: neuro-tts-voice-cycle {next|previous}")
        sys.exit(1)

    direction = sys.argv[1]
    voices = get_voices()
    if not voices:
        print("No voices found.")
        sys.exit(1)

    current = get_current_voice()
    try:
        idx = voices.index(current)
    except ValueError:
        idx = -1

    if idx == -1:
        set_voice(voices[0])
        return

    if direction == "next":
        idx = (idx + 1) % len(voices)
    else:
        idx = (idx - 1) % len(voices)

    set_voice(voices[idx])


if __name__ == "__main__":
    main()
