[Unit]
Description=NeuroPipe Assistant Service (Local AI)
After=sound.target pipewire.service pulseaudio.service graphical-session.target
PartOf=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/.local/bin
ExecStart=%h/.local/bin/neuro-assistant-service

Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target